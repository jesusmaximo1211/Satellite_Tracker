# Puerto del servidor proxy local
PORT=3001

# Credenciales de Space-Track.org (Opcional - Fallback de CelesTrak)
# Crear cuenta gratuita en: https://www.space-track.org/auth/createAccount
SPACETRACK_IDENTITY=tu_usuario_spacetrack
SPACETRACK_PASSWORD=tu_password_spacetrack

# API Key de N2YO (Opcional - Para validación cruzada de cualquier satélite)
# Obtener API Key gratuita en: https://www.n2yo.com/api/
N2YO_API_KEY=tu_api_key_n2yo

